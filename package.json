    "include-media": "^2.0.0",
    "next": "^16.0.7",
    "normalize.css": "^8.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.56.2",
    "react-hot-toast": "^2.5.2",
    "resend": "^4.5.0",
