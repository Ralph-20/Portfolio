{
  "name": "nextjs-starterkit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0",
    "yarn": "Please-use-npm"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier --write .",
    "format-check": "prettier --check .",
    "prepare": "husky install",
    "scaffold": "ts-node --project tsconfig.scripts.json scripts/scaffold-component.ts",
    "start:production": "npm-run-all --serial build start",
    "postinstall": "npx update-browserslist-db@latest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@hookform/resolvers": "^5.0.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "classnames": "^2.5.1",
    "contentful": "^11.5.22",
    "gsap": "npm:@gsap/shockingly@^3.12.5",
    "include-media": "^2.0.0",
    "next": "^14.2.0",
    "normalize.css": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.56.2",
    "react-hot-toast": "^2.5.2",
    "resend": "^4.5.0",
    "sass": "^1.77.7",
    "swiper": "^11.2.6",
    "three": "^0.167.1",
    "ts-node": "^10.9.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "husky": "^9.0.11",
    "typescript": "^5.5.3"
  }
}
